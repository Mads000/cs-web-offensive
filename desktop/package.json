{
  "name": "cswo-desktop",
  "productName": "CLUTCH",
  "version": "1.2.4",
  "description": "CLUTCH – Taktik-Shooter (Desktop-App)",
  "main": "main.js",
  "author": "Mads",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.mads.cswo",
    "productName": "CLUTCH",
    "icon": "../public/icon-512.png",
    "directories": {
      "output": "../../CS-WO-Build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "CS-WO-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CLUTCH",
      "runAfterFinish": true
    },
    "extraResources": [
      {
        "from": "../public",
        "to": "game",
        "filter": [
          "index.html",
          "manifest.json",
          "sw.js",
          "icon-*.png"
        ]
      },
      {
        "from": "vendor",
        "to": "vendor"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Mads000",
        "repo": "cs-web-offensive"
      }
    ]
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
