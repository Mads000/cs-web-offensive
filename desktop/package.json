{
  "name": "cswo-desktop",
  "productName": "CS-WO",
  "version": "1.0.0",
  "description": "Counter-Strike: Web Offensive – Desktop-App",
  "main": "main.js",
  "author": "Mads",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.mads.cswo",
    "productName": "CS-WO",
    "icon": "../public/icon-512.png",
    "directories": {
      "output": "../../CS-WO-Build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "CS-WO-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CS-WO",
      "runAfterFinish": true
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
